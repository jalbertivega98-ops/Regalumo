# --- Web ---
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.es
CONTACT_EMAIL=hola@tu-dominio.es
# Secreto largo y aleatorio (openssl rand -base64 48). Firma enlaces de descarga y sesiones.
APP_SECRET=
# Contraseña del panel /admin (sin ella el panel está desactivado)
ADMIN_PASSWORD=
# Protege el borrado automático programado (Vercel lo envía como Bearer)
CRON_SECRET=

# --- Base de datos y archivos privados (obligatorio en producción) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=private

# --- Pagos (Stripe) ---
# Empieza SIEMPRE con claves de prueba sk_test_... Las claves sk_live_ se bloquean
# salvo que ALLOW_LIVE_PAYMENTS=true (requiere autorización del propietario).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false
# Solo desarrollo local: pagos simulados sin Stripe (ignorado en producción)
# PAYMENTS_MODE=mock

# --- Correo de compra (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=REGALUMO <pedidos@tu-dominio.es>

# --- Buscadores ---
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- IA de imágenes (estilo "ilustración" del libro para colorear). Vacío = función pendiente ---
IMAGE_AI_PROVIDER=
IMAGE_AI_API_KEY=

# --- Límites y costes (opcionales; estos son los valores por defecto) ---
LIMIT_PROJECTS_PER_IP_DAY=25
LIMIT_UPLOADS_PER_IP_DAY=40
LIMIT_COLORING_PREVIEWS_PER_IP_DAY=20
LIMIT_ESCAPE_DEMOS_PER_IP_DAY=30
LIMIT_GLOBAL_FREE_GENERATIONS_DAY=3000
MAX_FREE_COST_EUR_DAY=5
MAX_UPLOAD_BYTES=10485760
RETENTION_UNPAID_DAYS=30
RETENTION_PAID_DAYS=365
